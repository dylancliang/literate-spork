# Required: your Anthropic API key (console.anthropic.com). Keep it out of git.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which models to use.
# The translation step uses the stronger model; the quick judgment steps
# (reading language names, ambiguous columns, follow-up requests) use the cheaper one.
TRANSLATE_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5
